# Copier vers .env (jamais commité) et renseigner les valeurs.

# Fournisseurs LLM (le routage tâche → modèle est dans config/models.yaml)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Treg (passerelle de données SEO). Jeton d'identité : préciser aussi l'organisation.
TREG_API_KEY=
TREG_ORG=

# Base de données : SQLite par défaut (data/seo_os.db). Production : PostgreSQL.
# DATABASE_URL=postgresql+psycopg://seo_os:motdepasse@localhost:5432/seo_os

# Cookie de session du cockpit (générer : python -c "import secrets; print(secrets.token_urlsafe(48))")
SEO_OS_SECRET_KEY=
# Mettre à 1 derrière HTTPS (production) pour des cookies « Secure »
SEO_OS_SECURE_COOKIES=0
